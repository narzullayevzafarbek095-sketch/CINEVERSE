# CineVerse AI — Environment Configuration
# Copy this file to .env to configure external live APIs

# Optional: TMDB (The Movie Database) API Key (v3 auth)
# Get a free key at: https://www.themoviedb.org/settings/api
# If not provided, CineVerse AI operates seamlessly in Curated Demo Mode with 50+ rich real movies!
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Google Gemini API Key for Natural Language Movie AI Synthesis
# Get a key at: https://aistudio.google.com/
# If not provided, CineVerse AI uses its built-in advanced multi-factor algorithmic recommendation engine.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Admin Dashboard Passcode (Default for local evaluation: cineverse2026)
VITE_ADMIN_PASSCODE=cineverse2026
